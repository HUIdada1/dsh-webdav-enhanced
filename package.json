{
  "name": "dsh-webdav-sync",
  "version": "0.2.0",
  "description": "WebDAV sync plugin for DeepSeek Harness: sync plugins, skills and model/provider configs across machines.",
  "type": "module",
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "schemastery": "^3.14.0",
    "unzipper": "^0.12.3",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^22.10.0",
    "@types/unzipper": "^0.10.11",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "webdav-server": "^2.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUIdada1/dsh-webdav-enhanced.git"
  },
  "author": "HUIdada1",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "webdav",
    "sync"
  ]
}
